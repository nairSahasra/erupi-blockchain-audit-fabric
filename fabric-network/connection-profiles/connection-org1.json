{
  "name": "erupi-network-org1",
  "version": "1.0.0",
  "client": {
    "organization": "Org1MSP",
    "connection": {
      "timeout": {
        "peer": {
          "endorser": "300"
        }
      }
    }
  },
  "organizations": {
    "Org1MSP": {
      "mspid": "Org1MSP",
      "peers": [
        "peer0.org1.erupi.com"
      ],
      "certificateAuthorities": [
        "ca.org1.erupi.com"
      ]
    }
  },
  "peers": {
    "peer0.org1.erupi.com": {
      "url": "grpcs://localhost:7051",
      "tlsCACerts": {
        "path": "fabric-network/organizations/peerOrganizations/org1.erupi.com/peers/peer0.org1.erupi.com/tls/ca.crt"
      },
      "grpcOptions": {
        "ssl-target-name-override": "peer0.org1.erupi.com",
        "hostnameOverride": "peer0.org1.erupi.com"
      }
    }
  }
}
