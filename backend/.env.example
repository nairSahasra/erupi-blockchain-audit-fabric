# Express Server Port
PORT=3001

# Fabric Channel and Chaincode
CHANNEL_NAME=erupi-channel
CHAINCODE_NAME=erupi-contract

# Organization 1 (Org1MSP - Government & Bank roles)
ORG1_MSP_ID=Org1MSP
ORG1_PEER_ENDPOINT=localhost:7051
ORG1_PEER_HOST_OVERRIDE=peer0.org1.erupi.com
ORG1_TLS_CERT_PATH=../fabric-network/organizations/peerOrganizations/org1.erupi.com/peers/peer0.org1.erupi.com/tls/ca.crt
ORG1_CERT_PATH=../fabric-network/organizations/peerOrganizations/org1.erupi.com/users/User1@org1.erupi.com/msp/signcerts/User1@org1.erupi.com-cert.pem
ORG1_KEY_PATH=../fabric-network/organizations/peerOrganizations/org1.erupi.com/users/User1@org1.erupi.com/msp/keystore/priv_sk

# Organization 2 (Org2MSP - Merchant & Auditor roles)
ORG2_MSP_ID=Org2MSP
ORG2_PEER_ENDPOINT=localhost:9051
ORG2_PEER_HOST_OVERRIDE=peer0.org2.erupi.com
ORG2_TLS_CERT_PATH=../fabric-network/organizations/peerOrganizations/org2.erupi.com/peers/peer0.org2.erupi.com/tls/ca.crt
ORG2_CERT_PATH=../fabric-network/organizations/peerOrganizations/org2.erupi.com/users/User1@org2.erupi.com/msp/signcerts/User1@org2.erupi.com-cert.pem
ORG2_KEY_PATH=../fabric-network/organizations/peerOrganizations/org2.erupi.com/users/User1@org2.erupi.com/msp/keystore/priv_sk
